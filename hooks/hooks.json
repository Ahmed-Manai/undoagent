{
  "description": "undoagent: snapshot the project before and after each prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/undoagent.js\" hook claude --all-projects",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/undoagent.js\" hook claude --all-projects",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
